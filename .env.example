# NEXOSPHERE Media Space configuration. Copy to .env.local (never commit real values).

# REQUIRED — scrypt hash of the shared workspace passphrase. Create it with:
#   npm run set-passphrase            (writes this line to .env.local for you)
#   npm run set-passphrase -- --print (prints it, for your hosting provider's secret settings)
# There is no default: until this is set, the workspace cannot be unlocked.
NEXO_PASSPHRASE_HASH=

# How long an unlocked session lasts before the passphrase is needed again (hours).
NEXO_SESSION_HOURS=12

# Where the SQLite database and uploaded files live. Must be a persistent volume in production.
DATA_DIR=./data

# Storage driver. Leave blank to auto-select S3/R2 when configured, then Vercel Blob, then local.
# Set explicitly to local, vercel-blob, or s3 to override.
STORAGE_DRIVER=

# Added automatically when a Vercel Blob store is connected to the project. Never commit its value.
# BLOB_READ_WRITE_TOKEN=

# Cloudflare R2 (or another S3-compatible private bucket). R2's region is "auto".
# Never commit the access-key values. The bucket must allow browser PUT requests from your site origin.
# S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=nexosmedia
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Upload limits in megabytes (enforced by the browser and the server).
MAX_IMAGE_MB=50
MAX_VIDEO_MB=1024

# Session cookies are marked Secure when NODE_ENV=production (serve over HTTPS).
# Set to "false" only to test a production build over plain HTTP on a local network.
# COOKIE_SECURE=true
